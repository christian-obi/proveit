{
  "name": "proveit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "spike:s3": "pnpm --filter s3-secrets run test",
    "spike:s6": "pnpm --filter s6-chainsig-match run match",
    "verify": "node packages/verify/bin/verify.ts",
    "agent-guard": "node packages/verify/bin/agent-guard.ts"
  },
  "devDependencies": {
    "viem": "2.57.16"
  }
}
