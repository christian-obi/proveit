# Copy to web/.env.local for local development (git ignores it):
#   cp web/.env.example web/.env.local
#
# Every value is optional: with none set, the app runs against the testnet deployment.
# On Railway, set the same names under the service's Variables. NEXT_PUBLIC_* values are
# baked in at build time, so restart `next dev` or redeploy after changing them.

# --- Server-only secrets. Never prefix these with NEXT_PUBLIC_. ---

# 1Click partner key (type "Distribution Channel"). Needed for real cross-chain quotes.
ONECLICK_API_KEY=

# OutLayer payment key used by /api/reveal for the live feed. It must match the network below.
# Testnet format: proveit-realist.testnet:1:<hex>
OUTLAYER_PAYMENT_KEY=

# The key for testnet OutLayer. OUTLAYER_PAYMENT_KEY above is then the mainnet key.
OUTLAYER_TESTNET_PAYMENT_KEY=

# --- Public settings. ---

# Which network the site opens on before a visitor uses the header switch.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The card on the home page, as <registry>:<id>. Empty means demo card 3.
NEXT_PUBLIC_FEATURED_CARD=

# --- Optional. Where anonymous reaction counts are saved. ---
# Point this at a Railway volume, or counts reset on every deploy.
# REACTIONS_PATH=/data/reactions.json
