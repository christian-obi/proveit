# Copy to web/.env.local for local development (git ignores it):
#   cp web/.env.example web/.env.local
#
# Every value is optional: with none set, the app runs against the testnet deployment.
# On Railway, set the same names under the service's Variables. NEXT_PUBLIC_* values are
# baked in at build time, so restart `next dev` or redeploy after changing them.

# --- Server-only secrets. Never prefix these with NEXT_PUBLIC_. ---

# 1Click partner key (type "Distribution Channel"). Needed for real cross-chain quotes.
ONECLICK_API_KEY=

# OutLayer payment key used by /api/reveal for the live feed. It must match the network below.
# Testnet format: proveit-realist.testnet:1:<hex>
OUTLAYER_PAYMENT_KEY=

# --- Public settings. The active values are the testnet defaults. ---

NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_REGISTRY=proveit-registry.testnet
NEXT_PUBLIC_DEMO_REGISTRY=proveit-demo-registry.testnet
NEXT_PUBLIC_ENCLAVE_PROJECT=proveit-realist.testnet/enclave
NEXT_PUBLIC_DEMO_ENCLAVE_PROJECT=proveit-realist.testnet/enclave-demo
NEXT_PUBLIC_OUTLAYER_API=https://testnet-api.outlayer.ai
NEXT_PUBLIC_OUTLAYER_CONTRACT=outlayer.testnet
# Comma-separated; on a rate limit the next endpoint is tried.
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org,https://test.rpc.fastnear.com
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The card on the home page, as <registry>:<id>. Empty means demo card 3.
NEXT_PUBLIC_FEATURED_CARD=

# --- Mainnet values, used after scripts/deploy-mainnet.sh has run. ---
# Replace <owner> with your mainnet account, without the .near suffix.
#
# NEXT_PUBLIC_NETWORK=mainnet
# NEXT_PUBLIC_REGISTRY=proveit.near
# NEXT_PUBLIC_ENCLAVE_PROJECT=<owner>.near/enclave
# NEXT_PUBLIC_OUTLAYER_API=https://api.outlayer.ai
# NEXT_PUBLIC_OUTLAYER_CONTRACT=outlayer.near
# NEXT_PUBLIC_NEAR_RPC=https://rpc.mainnet.fastnear.com
# NEXT_PUBLIC_EXPLORER=https://nearblocks.io
# NEXT_PUBLIC_SITE_URL=https://proveit-production-d47c.up.railway.app
# NEXT_PUBLIC_FEATURED_CARD=proveit.near:<card id>
